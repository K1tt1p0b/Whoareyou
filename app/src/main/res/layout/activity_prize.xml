<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/prize_layout_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FCE4EC"
        tools:context="com.kittipob.whoareyou.PrizeActivity">

        <TextView
            android:id="@+id/toneTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="โทนสีผิวของคุณคือ"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/skinColorTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="60dp" />

        <TextView
            android:id="@+id/skinColorTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="กำลังทำนายสีผิว..."
            android:textSize="30sp"
            android:textColor="#FF4081"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/toneTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/recommendedColorsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="สีที่แนะนำ"
            android:textSize="18sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/skinColorTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <!-- ✅ ปุ่มดูตารางสี (ไม่บังคับ) -->
        <Button
            android:id="@+id/previewPaletteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ดูตารางสี (ไม่บังคับ)"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintTop_toBottomOf="@id/recommendedColorsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:strokeColor="@color/black"
            app:strokeWidth="1.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/recommendedColorImageView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toBottomOf="@id/previewPaletteButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"/>



        <Button
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ถัดไป"
            android:textSize="18sp"
            android:textColor="@color/black"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintTop_toBottomOf="@id/recommendedColorImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:strokeColor="@color/black"
            app:strokeWidth="1.5dp"
            android:layout_marginTop="48dp" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="ย้อนกลับ"
            android:textSize="18sp"
            android:textColor="@color/black"
            app:layout_constraintWidth_percent="0.6"
            app:layout_constraintTop_toBottomOf="@id/nextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:strokeColor="@color/black"
            app:strokeWidth="1.5dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
